# dependencies
**/node_modules

# build output
**/dist
**/.cache
**/.tmp
**/build

# env - block all .env files EXCEPT .env.example
**/.env
**/.env.*
!**/.env.example

# logs
**/*.log

# OS
.DS_Store
Thumbs.db

# Strapi specific
.strapi
.strapi-updater.json
.strapi-cloud.json
public/uploads/*
!public/uploads/.gitkeep
app/public/uploads/*
!app/public/uploads/.gitkeep
exports/
license.txt
.tsbuildinfo
.eslintcache

# Product images (already in Strapi media library)
products/

# IDE
.vscode/
.idea/

# Test coverage
coverage/

# Package manager
.yarn/*
!.yarn/cache
!.yarn/unplugged
!.yarn/patches
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
yarn-error.log

# Archives
*.7z
*.zip
*.tar.gz
